<Window x:Class="NICRoute.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NICRoute · 网卡分流" Width="1220" Height="900" MinWidth="1030" MinHeight="760" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="42" Height="42" Background="{StaticResource Accent}" CornerRadius="9" Margin="0,0,12,0">
          <Canvas Width="28" Height="28"><Path Stroke="{StaticResource Surface}" StrokeThickness="2" Data="M 4,14 L 11,14 L 17,6 L 24,6 M 11,14 L 17,22 L 24,22" /><Ellipse Fill="{StaticResource Surface}" Width="5" Height="5" Canvas.Left="1" Canvas.Top="11.5" /><Ellipse Fill="{StaticResource Surface}" Width="5" Height="5" Canvas.Left="21" Canvas.Top="3.5" /><Ellipse Fill="{StaticResource Surface}" Width="5" Height="5" Canvas.Left="21" Canvas.Top="19.5" /></Canvas>
        </Border>
        <StackPanel><TextBlock Text="NICRoute" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="为每个应用，选择一条网络。" Style="{StaticResource MutedText}" /></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Card}" Padding="12,7" Margin="0,0,14,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="{StaticResource Muted}" Width="7" Height="7" Margin="0,0,7,0" /><TextBlock x:Name="StatusText" Text="尚未启动" FontSize="12" /></StackPanel></Border>
        <Button x:Name="StartButton" Content="启动分流" Style="{StaticResource PrimaryButton}" Click="Start_Click" MinWidth="112" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,24,0,17">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="网卡与全局出口" FontSize="19" FontWeight="SemiBold" /><TextBlock x:Name="AdapterSummary" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel>
      <Button Grid.Column="1" Content="刷新网卡" Click="Refresh_Click" Style="{StaticResource SmallButton}" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Grid.Row="2">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="155" Margin="0,0,0,14">
        <ItemsControl x:Name="AdapterItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}" Width="267" Padding="15,12" Margin="0,0,10,0">
              <StackPanel><Grid><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,0,85,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding Available}" Value="True"><Setter Property="Foreground" Value="{StaticResource Success}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <TextBlock Text="{Binding AddressLabel}" FontFamily="{StaticResource DataFont}" FontSize="11" Margin="0,9,0,6" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,10,0,0" ToolTip="{Binding TrafficDetail}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="↑ 上行" FontSize="10" Foreground="{StaticResource Accent}" /><TextBlock Text="{Binding UploadRate}" FontFamily="{StaticResource DataFont}" FontSize="13" Margin="0,3,0,0" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="↓ 下行" FontSize="10" Foreground="{StaticResource Success}" /><TextBlock Text="{Binding DownloadRate}" FontFamily="{StaticResource DataFont}" FontSize="13" Margin="0,3,0,0" /></StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,20">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="全局默认网卡" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="没有单独规则的应用，以及回退到全局的应用，使用此出口。" Style="{StaticResource MutedText}" Margin="0,5,14,0" TextWrapping="Wrap" /></StackPanel>
          <ComboBox x:Name="GlobalAdapter" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="GlobalAdapter_Changed" VerticalAlignment="Center" />
          <Button x:Name="SaveButton" Grid.Column="2" Content="保存并应用" Click="Save_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>
    <TabControl Grid.Row="3" x:Name="MainTabs">
      <TabItem x:Name="ConfiguredAppsTab" Header="已配置应用">
        <Grid Margin="18,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="已配置应用" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="RuleSummary" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="＋ 添加应用" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid><TextBox x:Name="RuleSearch" ToolTip="搜索应用名称、exe 路径或应用包名" TextChanged="RuleSearch_Changed" AutomationProperties.Name="搜索已配置应用" />
              <TextBlock Text="搜索名称、路径或应用包名" Margin="12,0" IsHitTestVisible="False" Foreground="{StaticResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RuleSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
            <ComboBox x:Name="RuleKindFilter" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="RuleFilter_Changed" AutomationProperties.Name="应用类型筛选"><ComboBoxItem Content="全部应用类型" Tag="all" /><ComboBoxItem Content="Windows 应用" Tag="package" /><ComboBoxItem Content="桌面程序" Tag="desktop" /></ComboBox>
            <ComboBox x:Name="RuleStateFilter" Grid.Column="2" Margin="10,0,0,0" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="RuleFilter_Changed" AutomationProperties.Name="启用状态筛选"><ComboBoxItem Content="全部状态" Tag="all" /><ComboBoxItem Content="已启用" Tag="enabled" /><ComboBoxItem Content="已停用" Tag="disabled" /></ComboBox>
            <Button Grid.Column="3" Content="重置筛选" Click="ResetRuleFilters_Click" Style="{StaticResource SmallButton}" Margin="10,0,0,0" />
          </Grid>
          <Grid Grid.Row="2" Background="{StaticResource Base}" Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectVisibleRules" Margin="10,0,0,0" Click="SelectVisibleRules_Click" AutomationProperties.Name="选择当前列表中的全部应用" ToolTip="选择当前列表中的全部应用" />
            <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions>
            <TextBlock Text="应用" Margin="12,0" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" Text="首选网卡" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="2" Text="不可用时" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="3" x:Name="RouteColumnTitle" Text="规则出口预览" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="4" Text="操作" Style="{StaticResource MutedText}" />
            </Grid>
          </Grid>
          <Grid Grid.Row="3">
            <ScrollViewer x:Name="RulesScrollViewer" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RuleItems">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Tag="{Binding Rule.Id}" Click="SelectRule_Click" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=选择 {0}}" />
                    <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions>
                    <Grid Margin="10,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="37" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Border Background="{StaticResource AccentSoft}" Width="29" Height="32" CornerRadius="4" HorizontalAlignment="Left"><TextBlock Text="{Binding Glyph}" Foreground="{StaticResource Accent}" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" /><TextBlock Text="{Binding KindLabel}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" /></StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Primary}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Primary}" />
                    <TextBlock Grid.Column="2" Text="{Binding Fallback}" Margin="0,0,8,0" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Route}" Foreground="{Binding RouteBrush}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding EnabledLabel}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="编辑" Tag="{Binding Rule}" Click="Edit_Click" Style="{StaticResource SmallButton}" Padding="8,5" />
                      <Button Content="{Binding ToggleLabel}" Tag="{Binding Rule}" Click="ToggleRule_Click" Style="{StaticResource SmallButton}" Margin="5,0" Padding="8,5" />
                      <Button Content="删除" Tag="{Binding Rule}" Click="Delete_Click" Style="{StaticResource SmallButton}" Foreground="{StaticResource Danger}" Padding="8,5" ToolTip="删除规则" AutomationProperties.Name="删除规则" />
                    </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl></ScrollViewer>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
              <TextBlock x:Name="EmptyTitle" Text="还没有应用规则" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyDetail" Text="添加一个 Windows 应用或桌面程序，为它指定网卡和回退方式。" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="4" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="RuleCount" Style="{StaticResource MutedText}" />
            <StackPanel x:Name="RuleBatchActions" Orientation="Horizontal" Visibility="Collapsed">
              <TextBlock x:Name="RuleSelectionCount" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
              <Button Content="启用" Tag="enable" Click="BatchRules_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
              <Button Content="停用" Tag="disable" Click="BatchRules_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
              <Button Content="删除" Tag="delete" Click="BatchRules_Click" Style="{StaticResource SmallButton}" Foreground="{StaticResource Danger}" Margin="0,0,6,0" />
              <Button Content="取消选择" Click="ClearRuleSelection_Click" Style="{StaticResource SmallButton}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="导入配置" Click="Import_Click" Style="{StaticResource SmallButton}" Margin="0,0,8,0" /><Button Content="导出配置" Click="Export_Click" Style="{StaticResource SmallButton}" /></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="TrafficTab" Header="流量监控">
        <Grid Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,16"><TextBlock Text="每张网卡的上行与下行" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="每秒刷新 · 未启动分流也能监控 · 统计整张网卡，包含其他应用和局域网流量。" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel>
          <Grid Grid.Row="1" Height="34" Background="{StaticResource Base}" Margin="0,0,17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
            <TextBlock Text="网卡" Margin="12,0" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" Text="↑ 上行速率" Foreground="{StaticResource Accent}" /><TextBlock Grid.Column="2" Text="↓ 下行速率" Foreground="{StaticResource Success}" /><TextBlock Grid.Column="3" Text="本次上行" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="4" Text="本次下行" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="5" Text="采样状态" Style="{StaticResource MutedText}" />
          </Grid>
          <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Visible"><ItemsControl x:Name="TrafficItems"><ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14" ToolTip="{Binding TrafficDetail}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="12,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" /><TextBlock Text="{Binding AddressLabel}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding UploadRate}" FontFamily="{StaticResource DataFont}" Foreground="{StaticResource Accent}" /><TextBlock Grid.Column="2" Text="{Binding DownloadRate}" FontFamily="{StaticResource DataFont}" Foreground="{StaticResource Success}" /><TextBlock Grid.Column="3" Text="{Binding Uploaded}" FontFamily="{StaticResource DataFont}" /><TextBlock Grid.Column="4" Text="{Binding Downloaded}" FontFamily="{StaticResource DataFont}" /><TextBlock Grid.Column="5" Text="{Binding MonitorStatus}" FontSize="11" Foreground="{StaticResource Muted}" />
            </Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <TextBlock x:Name="TrafficEmpty" Text="暂未发现可监控的网卡。请连接网卡后刷新。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Visibility="Collapsed" />
          </Grid>
          <TextBlock Grid.Row="3" Text="累计量从本次打开软件后开始采样，不含启动前的流量。网卡计数重置、重新连接或系统休眠恢复后，会重新建立速率基线。不同虚拟网卡与物理网卡可能记录同一份流量。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0" />
        </Grid>
      </TabItem>
      <TabItem Header="网络检测">
        <StackPanel Margin="25" MaxWidth="780" HorizontalAlignment="Left">
          <TextBlock Text="如何判断网卡可用" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="默认根据网卡连接状态和 IP 地址判断。若希望识别“网线已连，但无法访问外网”，可启用指定地址的 TCP 连通性检测。" TextWrapping="Wrap" Margin="0,12,0,15" Foreground="{StaticResource Muted}" LineHeight="23" />
          <CheckBox x:Name="ProbeEnabled" Content="启用连通性检测（每 5 秒一次，连续失败两次才回退）" Checked="NetworkOption_Changed" Unchecked="NetworkOption_Changed" />
          <TextBlock Text="检测地址 / 端口" Margin="0,18,0,7" /><StackPanel Orientation="Horizontal"><TextBox x:Name="ProbeAddress" Width="230" TextChanged="NetworkText_Changed" /><TextBox x:Name="ProbePort" Width="90" Margin="10,0,0,0" TextChanged="NetworkText_Changed" /></StackPanel>
          <TextBlock Text="检测结果只代表这个目标是否可达。请选择你所在网络允许访问的地址和端口。" Style="{StaticResource MutedText}" Margin="0,10,0,12" TextWrapping="Wrap" />
          <TextBlock Text="DNS 服务器 IP" Margin="0,12,0,7" /><TextBox x:Name="DnsAddress" Width="330" HorizontalAlignment="Left" TextChanged="NetworkText_Changed" />
          <TextBlock Text="DNS 查询经当前出口发送。Windows 的共享 DNS 服务发出的查询使用全局出口。修改后点击上方“保存并应用”。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23" />
        </StackPanel>
      </TabItem>
      <TabItem x:Name="UpdatesTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="软件更新" /><Ellipse x:Name="UpdateDot" Width="6" Height="6" Fill="{StaticResource Danger}" Margin="7,0,0,0" Visibility="Collapsed" /></StackPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25" MaxWidth="800" HorizontalAlignment="Left">
          <TextBlock Text="让 NICRoute 保持最新" FontSize="21" FontWeight="SemiBold" />
          <TextBlock x:Name="InstalledVersionText" Foreground="{StaticResource Muted}" Margin="0,10,0,20" />
          <Border Style="{StaticResource Card}" Padding="18" MinWidth="700"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="检查 GitHub 官方更新" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="UpdateStatusText" Text="尚未检查" Margin="0,8,15,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /></StackPanel><Grid Grid.Column="1" MinHeight="48"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" VerticalAlignment="Center" /></Grid></Grid></Border>
          <CheckBox x:Name="AutoUpdateCheck" Content="启动后自动检查更新" Margin="0,22,0,15" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed" />
          <Grid MaxWidth="590" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="25" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="更新渠道" Margin="0,0,0,7" /><TextBlock Grid.Column="2" Text="下载连接数" Margin="0,0,0,7" />
            <ComboBox x:Name="UpdateChannel" Grid.Row="1" SelectedValuePath="Tag" SelectionChanged="UpdatePreference_Changed"><ComboBoxItem Content="稳定版" Tag="stable" /><ComboBoxItem Content="测试版及稳定版" Tag="beta" /></ComboBox>
            <ComboBox x:Name="UpdateConnections" Grid.Row="1" Grid.Column="2" SelectionChanged="UpdatePreference_Changed" />
          </Grid>
          <TextBlock Text="下载使用 MUDL，多个镜像可同时传输同一个文件，最多 32 个连接。镜像只提供文件，版本与文件摘要由官方更新信息确定。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="24" />
          <TextBlock Text="发现更新后可跳过该版本、暂时忽略，或下载并重启更新。更新包会在下载完成及安装前重新校验；更新失败会尝试恢复原版本，网卡规则保留。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="24" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="运行日志"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><Grid><TextBlock Text="保留最近 500 条记录，包含实际连接的匹配与出口。" Style="{StaticResource MutedText}" /><Button Content="清空日志" HorizontalAlignment="Right" Click="ClearLog_Click" Style="{StaticResource SmallButton}" /></Grid><TextBox x:Name="LogText" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource DataFont}" FontSize="11" Background="{StaticResource Base}" /></Grid></TabItem>
      <TabItem Header="使用说明"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25" MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Text="从应用到网卡，按规则选择出口。" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18" />
        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="26"><Run FontWeight="Bold">开始使用</Run><LineBreak />选择全局默认网卡，再添加 Windows 应用或 exe 规则。每个应用选择首选网卡及回退方式，点击“保存并应用”，最后启动分流。启动时需要管理员权限以创建虚拟网卡。<LineBreak /><LineBreak /><Run FontWeight="Bold">三种回退</Run><LineBreak />不联网：拒绝该应用的新连接。全局默认：跟随全局出口。指定网卡：使用另一张网卡，若它也不可用则不联网。首选网卡恢复后自动切回。已建立的连接会关闭，由应用重连。<LineBreak /><LineBreak /><Run FontWeight="Bold">Windows 应用</Run><LineBreak />从当前 Windows 用户已安装的 UWP、Microsoft Store 和 MSIX 应用中按名称选择。规则按应用包身份保存，匹配包目录中的联网进程，适配常规版本更新。应用转移到其他磁盘后可刷新应用列表并重新保存。共享系统宿主、包外服务和代理代发的流量无法保证归属于原始应用，需为实际联网进程另外添加规则。<LineBreak /><LineBreak /><Run FontWeight="Bold">生效范围</Run><LineBreak />分流运行期间接管普通路由的 IPv4 / IPv6 TCP、UDP 流量。已有连接建议重启应用后再验证。规则不覆盖回环通信、显式绑定物理接口绕过 TUN 的流量、内核流量或其他 VPN 提前接管的流量。全局网卡不可用时全局出口拒绝连接；选择 Windows 自动时由系统选择。<LineBreak /><LineBreak /><Run FontWeight="Bold">停止与重新应用</Run><LineBreak />停止或退出后恢复 Windows 自身路由。“保存并应用”在运行中会重启引擎，期间网络短暂恢复系统路由；自动回退只切换出口，不重建 TUN。它是分流工具，不是防泄漏防火墙；退出、引擎崩溃及重新应用期间不保证断网隔离。请避免与其他 TUN / VPN 同时启用。<LineBreak /><LineBreak /><Run FontWeight="Bold">验证出口</Run><LineBreak />在规则中的应用里访问你信任的 IP 查询服务，检查源地址，并在运行日志里核对进程及出口。局域网访问也会遵循规则。网络拓扑、VPN 和防火墙可能影响网卡是否能到达目的地址。</TextBlock>
        <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,24,0,0" TextWrapping="Wrap" />
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
