<Window x:Class="NICRoute.App.UpdateDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NICRoute 软件更新" Width="700" Height="610" MinWidth="560" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Dialog_Closing">
  <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="72" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Text="发现新版本" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18" />
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><FlowDocumentScrollViewer x:Name="NotesViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" /></Border>
    <StackPanel Grid.Row="2" VerticalAlignment="Center"><ProgressBar x:Name="DownloadBar" Height="5" Minimum="0" Maximum="100" Visibility="Hidden" /><TextBlock x:Name="ProgressText" Text="更新时将停止分流并重启软件，已有规则会保留。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="185" /></Grid.ColumnDefinitions>
      <Button x:Name="SkipButton" Content="跳过此版本" Click="Skip_Click" />
      <Button x:Name="IgnoreButton" Grid.Column="1" Content="忽略" Click="Ignore_Click" Margin="10,0,0,0" />
      <Button x:Name="DownloadButton" Grid.Column="3" Content="下载并重启更新" Click="Download_Click" Style="{StaticResource PrimaryButton}" MinHeight="42" />
    </Grid>
  </Grid>
</Window>
